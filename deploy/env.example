# Production .env — copy to /var/www/workspace-app/.env on server

# ── Django core ────────────────────────────────────────
DEBUG_MODE=False
SECRET_KEY=__CHANGE_ME__generate_via_python_-c_'import_secrets;print(secrets.token_urlsafe(60))'
QR_SECRET=__CHANGE_ME__random_64_chars__
HEALTHCHECK_TOKEN=__CHANGE_ME__random_32_chars__
ALLOWED_HOSTS=consolidatorparts.com,www.consolidatorparts.com
CSRF_TRUSTED_ORIGINS=https://consolidatorparts.com,https://www.consolidatorparts.com
SITE_URL=https://consolidatorparts.com
USE_HTTPS=True
BEHIND_PROXY=True
# Add only networks from which the application process receives proxy traffic.
TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128,172.16.0.0/12
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
CSP_STRICT=True

# Request and in-memory upload limits. Per-file limits are configured below.
DATA_UPLOAD_MAX_MEMORY_SIZE=2097152
DATA_UPLOAD_MAX_NUMBER_FIELDS=1000
DATA_UPLOAD_MAX_NUMBER_FILES=20
FILE_UPLOAD_MAX_MEMORY_SIZE=2097152
MAX_IMPORT_FILE_BYTES=2097152
MAX_IMPORT_ROWS=10000
MAX_QUOTE_ITEMS=50
MAX_ORDER_DOCUMENT_BYTES=10485760

# ── Database (Postgres) ────────────────────────────────
DATABASE_URL=postgresql://consolidator:CHANGE_ME@127.0.0.1:5432/consolidator

# ── Redis / очереди / общий кэш ────────────────────────
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CHANNELS_REDIS_URL=redis://127.0.0.1:6379/1
DEFAULT_CACHE_URL=redis://127.0.0.1:6379/2
PRICELIST_CACHE_URL=redis://127.0.0.1:6379/4

# ── AI ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Payments ───────────────────────────────────────────
# P0-2: без этого payment_callback вернёт 503
PAYMENT_CALLBACK_SECRET=__CHANGE_ME__random_64_chars__
PAYMENT_CALLBACK_MAX_BODY_BYTES=65536
# Stripe is intentionally disabled until refunds and reconciliation are complete.
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
PAYMENT_ENGINE=wallet

# Outgoing webhook signatures and SSRF allowlists.
WEBHOOK_SECRET=__CHANGE_ME__random_64_chars__
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOW_PRIVATE_IPS=False
WEBHOOK_ALLOW_INSECURE_HTTP=False
LOGISTICS_ALLOWED_HOSTS=
LOGISTICS_ALLOW_PRIVATE_IPS=False
LOGISTICS_ALLOW_INSECURE_HTTP=False
FX_ALLOWED_HOSTS=open.er-api.com
FX_ALLOW_PRIVATE_IPS=False
FX_ALLOW_INSECURE_HTTP=False
GOOGLE_SHEETS_ALLOWED_HOSTS=docs.google.com,*.googleusercontent.com
GOOGLE_SHEETS_ALLOW_PRIVATE_IPS=False
GOOGLE_SHEETS_ALLOW_INSECURE_HTTP=False

# Deposit details are secrets and must never be committed with real values.
TOPUP_BANK_BENEFICIARY=
TOPUP_BANK_BENEFICIARY_ADDR=
TOPUP_BANK_TRADE_LICENSE=
TOPUP_BANK_TAX_NO=
TOPUP_BANK_NAME=
TOPUP_BANK_BRANCH_CODE=
TOPUP_BANK_SWIFT=
TOPUP_BANK_IBAN=
TOPUP_BANK_ACCOUNT=
TOPUP_BANK_CURRENCY=
TOPUP_BANK_CONTACT_NAME=
TOPUP_BANK_CONTACT_PHONE=
TOPUP_BANK_CONTACT_EMAIL=
TOPUP_USDT_ADDRESS=

# ── Email (для magic-link, уведомлений) ────────────────
EMAIL_HOST=smtp.yandex.ru
EMAIL_HOST_USER=noreply@consolidatorparts.com
EMAIL_HOST_PASSWORD=__CHANGE_ME__
DEFAULT_FROM_EMAIL=Consolidator Parts <noreply@consolidatorparts.com>
EMAIL_VERIFICATION_REQUIRED=True

# ── Telegram-бот ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=__CHANGE_ME__random_64_chars__

# Upload scanning is fail-closed in production.
ENABLE_VIRUS_SCAN=True
VIRUS_SCAN_REQUIRED=True
