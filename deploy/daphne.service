[Unit]
Description=Daphne ASGI server for workspace-app (WebSocket /ws/*)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
RuntimeDirectory=daphne
RuntimeDirectoryMode=0775
WorkingDirectory=/var/www/workspace-app
EnvironmentFile=/var/www/workspace-app/.env

ExecStart=/var/www/workspace-app/venv/bin/daphne \
  -b 127.0.0.1 -p 8001 \
  --proxy-headers \
  --access-log - \
  consolidator_site.asgi:application

Restart=always
RestartSec=3
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
