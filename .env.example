DEBUG_MODE=True
SECRET_KEY=dev-secret-change-in-production
QR_SECRET=dev-qr-secret-change-in-production
HEALTHCHECK_TOKEN=
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://127.0.0.1:8001,http://localhost,http://localhost:8001
USE_HTTPS=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=same-origin
X_FRAME_OPTIONS=DENY

MAX_IMPORT_FILE_BYTES=52428800
MAX_IMPORT_ROWS=200000
MAX_QUOTE_ITEMS=50
MAX_ORDER_DOCUMENT_BYTES=10485760

# ── База данных (docker-compose подставляет DATABASE_URL автоматически) ──
# Для локальной разработки без Docker — оставить пустым, используется SQLite.
DATABASE_URL=

# ── Redis / Celery ────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CHANNELS_REDIS_URL=redis://localhost:6379/1
PRICELIST_CACHE_URL=redis://localhost:6379/4

# ── Внешние API ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Исходящие вебхуки ─────────────────────────────────────────────────────
# В проде указывать только доверенные домены через запятую.
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOW_PRIVATE_IPS=False
WEBHOOK_ALLOW_INSECURE_HTTP=False
LOGISTICS_ALLOWED_HOSTS=
LOGISTICS_ALLOW_PRIVATE_IPS=False
LOGISTICS_ALLOW_INSECURE_HTTP=False
FX_ALLOWED_HOSTS=open.er-api.com
FX_ALLOW_PRIVATE_IPS=False
FX_ALLOW_INSECURE_HTTP=False
GOOGLE_SHEETS_ALLOWED_HOSTS=docs.google.com
GOOGLE_SHEETS_ALLOW_PRIVATE_IPS=False
GOOGLE_SHEETS_ALLOW_INSECURE_HTTP=False
