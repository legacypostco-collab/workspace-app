#: assistant/actions.py:349
msgid ""
"Это действие доступно только верифицированным продавцам. Пройдите KYB-"
"верификацию: «Начать верификацию»."
msgstr "此操作仅对已验证的卖家开放。请完成 KYB 验证：「开始验证」。"

#: assistant/actions.py:488
msgid "Связаться с менеджером"
msgstr "联系经理"

#: assistant/actions.py:490 assistant/actions.py:496 assistant/actions.py:4533
msgid "Связаться с оператором"
msgstr "联系操作员"

#: assistant/actions.py:546 assistant/views.py:219
msgid ""
"🔒 Чтобы продолжить — зарегистрируйтесь прямо здесь, в чате.\n"
"Это займёт 20 секунд."
msgstr ""
"🔒 要继续，请直接在聊天中注册。\n"
"仅需 20 秒。"

#: assistant/actions.py:548 assistant/views.py:101 assistant/views.py:223
msgid "🚀 Зарегистрироваться"
msgstr "🚀 注册"

#: assistant/actions.py:549 assistant/views.py:224
msgid "У меня есть аккаунт"
msgstr "我已有账户"

#: assistant/actions.py:560
msgid "очередь продавца"
msgstr "卖家队列"

#: assistant/actions.py:561
msgid "дашборд продавца"
msgstr "卖家仪表盘"

#: assistant/actions.py:562
msgid "входящие RFQ"
msgstr "收到的询价"

#: assistant/actions.py:563
msgid "каталог продавца"
msgstr "卖家目录"

#: assistant/actions.py:564
msgid "финансы продавца"
msgstr "卖家财务"

#: assistant/actions.py:565
msgid "рейтинг продавца"
msgstr "卖家评分"

#: assistant/actions.py:566
msgid "переговоры продавца"
msgstr "卖家谈判"

#: assistant/actions.py:567 assistant/actions.py:571
msgid "ответ на RFQ"
msgstr "询价回复"

#: assistant/actions.py:568
msgid "отгрузка заказа"
msgstr "订单发货"

#: assistant/actions.py:569
msgid "движение заказа по этапам"
msgstr "订单按阶段推进"

#: assistant/actions.py:570
msgid "загрузка прайс-листа"
msgstr "价目表上传"

#: assistant/actions.py:577
#, python-format
msgid ""
"🔁 «%(hint)s» — это раздел продавца, а вы сейчас в роли «Покупатель».\n"
"Переключите роль в шапке (Покупатель ↔ Продавец) или нажмите кнопку ниже."
msgstr ""
"🔁 “%(hint)s” 是卖家板块，但您当前处于“买家”角色。\n"
"请在顶栏切换角色（买家 ↔ 卖家），或点击下方按钮。"

#: assistant/actions.py:580
msgid "🔁 Переключиться на «Продавец»"
msgstr "🔁 切换到「卖家」"

#: assistant/actions.py:582 assistant/actions.py:2808 assistant/actions.py:7311
#: assistant/actions.py:7356 assistant/actions.py:7388
#: assistant/actions.py:7441 assistant/actions.py:7481
