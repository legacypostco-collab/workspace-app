#: assistant/seller_actions.py:3646 assistant/seller_actions.py:3747
msgid "🏠 Главная"
msgstr "🏠 首页"

#: assistant/actions.py:585
#, python-format
msgid "⚠️ Нет прав на действие '%(action_name)s' для роли %(role)s"
msgstr "⚠️ 角色 %(role)s 无权执行操作 '%(action_name)s'"

#: assistant/actions.py:592 assistant/negotiation.py:496
msgid "🚀 Начать верификацию"
msgstr "🚀 开始验证"

#: assistant/actions.py:597
#, python-format
msgid "⚠️ Действие '%(action_name)s' не зарегистрировано"
msgstr "⚠️ 操作 '%(action_name)s' 未注册"

#: assistant/actions.py:607
#, python-format
msgid "⚠️ Ошибка выполнения: %(e)s"
msgstr "⚠️ 执行错误：%(e)s"

#: assistant/actions.py:647
msgid ""
"Поиск запчастей по каталогу. Поддерживает свободный текст и список OEM-"
"артикулов (через query как многострочную строку или через articles[]). При "
">=2 артикулах возвращает spec_results карточку (KPI + таблица), иначе — "
"карточки product."
msgstr ""
"按目录搜索配件。支持自由文本和 OEM 货号列表（通过 query 多行字符串或 "
"articles[]）。当 >=2 个货号时返回 spec_results 卡片（KPI + 表格），否则返回 "
"product 卡片。"

#: assistant/actions.py:652
msgid "Свободный текст или несколько артикулов через перевод строки/запятую"
msgstr "自由文本或多个货号，以换行/逗号分隔"

#: assistant/actions.py:653
msgid "Список OEM-артикулов для точного поиска"
msgstr "用于精确搜索的 OEM 货号列表"

#: assistant/actions.py:654 assistant/actions.py:1465
msgid "Фильтр по бренду"
msgstr "按品牌筛选"

#: assistant/actions.py:655
msgid "Фильтр по категории"
msgstr "按类别筛选"

#: assistant/actions.py:656
msgid "Макс. кол-во результатов (default 20, max 50)"
msgstr "最大结果数（默认 20，最大 50）"

#: assistant/actions.py:662
msgid ""
"Многострочный разбор спецификации/BoM. Считает best mix, находит OEM/"
"аналоги, помечает недоступные. Используй когда пользователь говорит "
"«посчитай по парку», «обработай спеку», «сколько будет стоить», «лучший "
"микс»."
msgstr ""
"多行规格/BoM 解析。计算 best mix，查找 OEM/替代件，标记不可用项。当用户说「按"
"车队计算」「处理规格」「需要多少钱」「最佳组合」时使用。"

#: assistant/actions.py:667
msgid "Фильтр: только OEM или только аналоги"
msgstr "筛选：仅 OEM 或仅替代件"

#: assistant/actions.py:668
msgid "Макс. лидтайм в днях (фильтр)"
msgstr "最大交货周期（天）（筛选）"

#: assistant/actions.py:674
msgid ""
"Возвращает ранжированный топ-N поставщиков под текущую спеку. Используй "
"когда пользователь просит «топ-3 поставщиков», «сравни поставщиков», «лучшие "
"предложения»."
msgstr ""
"返回针对当前规格排名的前 N 名供应商。当用户请求「前 3 名供应商」「对比供应"
"商」「最佳报价」时使用。"

#: assistant/actions.py:679
msgid "Сколько поставщиков (default 3)"
msgstr "多少家供应商（默认 3）"

#: assistant/actions.py:686
msgid ""
"Создаёт RFQ (запрос котировок). Принимает product_ids (UUID из каталога) ИЛИ "
"articles (OEM-номера) ИЛИ свободный query. Поставщики получат уведомление."
msgstr ""
"创建 RFQ（询价）。接受 product_ids（目录 UUID）或 articles（OEM 编号）或自由 "
"query。供应商将收到通知。"

#: assistant/actions.py:691
msgid "UUIDs товаров из каталога"
msgstr "目录中的商品 UUID"

#: assistant/actions.py:692
msgid "Список OEM-артикулов"
msgstr "OEM 零件号列表"

#: assistant/actions.py:693
msgid "Свободный текст запроса"
msgstr "自由文本查询"

#: assistant/actions.py:694
msgid "Кол-во по каждой позиции (default 1)"
msgstr "每项数量（默认 1）"

#: assistant/actions.py:699
msgid "Список заказов пользователя."
msgstr "用户的订单列表。"

#: assistant/actions.py:703
msgid "Фильтр по статусу"
msgstr "按状态筛选"

#: assistant/actions.py:709
msgid "Детали конкретного заказа."
msgstr "特定订单的详情。"

#: assistant/actions.py:713
msgid "Список или статус RFQ. Без params — все RFQ пользователя."
msgstr "RFQ 列表或状态。无 params 时返回用户所有 RFQ。"

#: assistant/actions.py:720
msgid "Трекинг отгрузки по order_id."
msgstr "按 order_id 追踪发货。"

#: assistant/actions.py:724
msgid ""
"ТЗ §4.1: текущий уровень auto-discount buyer'а по годовому обороту (0/1/2/3)."
msgstr "技术规格 §4.1：买家当前按年营业额的 auto-discount 级别（0/1/2/3）。"

#: assistant/actions.py:728
msgid "Бюджет/расходы пользователя за период."
msgstr "用户在该周期内的预算/支出。"

#: assistant/actions.py:735
msgid "Аналитика для роли (дашборд-метрики)."
msgstr "角色分析（仪表盘指标）。"

#: assistant/actions.py:739
msgid "Сравнение поставщиков по метрикам."
msgstr "按指标比较供应商。"

#: assistant/actions.py:746
msgid "Сравнение товаров side-by-side."
msgstr "商品并排比较。"

#: assistant/actions.py:754
msgid "Список рекламаций пользователя."
msgstr "用户的索赔列表。"

#: assistant/actions.py:758
msgid "SLA-отчёт по нарушениям."
msgstr "SLA 违规报告。"

#: assistant/actions.py:762
msgid "Отчёт по спросу для поставщика."
msgstr "面向供应商的需求报告。"

#: assistant/actions.py:767
msgid ""
"Формирует коммерческое предложение (КП) по существующему RFQ. Используй "
"когда пользователь просит «сформируй КП», «сделай коммерческое предложение», "
"«выгрузи КП», «нужно КП по RFQ X». Возвращает ссылку на страницу КП с "
"возможностью скачать PDF."
msgstr ""
"根据现有 RFQ 生成报价单（КП）。当用户请求「生成报价单」「制作商业报价」「导出"
"报价单」「需要 RFQ X 的报价单」时使用。返回报价单页面链接并可下载 PDF。"

#: assistant/actions.py:772
msgid "ID RFQ. Если не указан — последний созданный RFQ пользователя."
msgstr "RFQ ID。若未指定，则为用户最近创建的 RFQ。"

#: assistant/actions.py:778
msgid ""
"Операторская сводка: KPI заказов в работе, SLA, оборот, приоритетная очередь."
msgstr "运营汇总：进行中订单的 KPI、SLA、营业额、优先队列。"

#: assistant/actions.py:782
msgid ""
"Очередь заказов, требующих внимания оператора. filter: all|breached|at_risk|"
"refund|awaiting_reserve|open."
msgstr ""
"需要运营人员关注的订单队列。filter: all|breached|at_risk|refund|"
"awaiting_reserve|open。"

#: assistant/actions.py:789
msgid ""
"Список заказов с нарушенным или под угрозой SLA + время до/после дедлайна."
msgstr "SLA 已违反或面临风险的订单列表 + 距截止时间的剩余/超出时间。"

#: assistant/actions.py:793
msgid ""
"Расширенный operator-view заказа: статусы, текущее назначение оператора, "
"аудит-лог."
msgstr "订单的扩展 operator-view：状态、当前运营人员分配、审计日志。"

#: assistant/actions.py:796 templates/operator/logist/analytics.html:167
#: templates/operator/logist/dashboard.html:40
#: templates/operator/manager/analytics.html:180
#: templates/operator/manager/shipments.html:38
msgid "ID заказа"
msgstr "订单 ID"

#: assistant/actions.py:801
msgid ""
"Назначить суб-роль оператора (manager/logist/customs/payments) на заказ. Шаг "
"1 без to_role/confirmed → форма; шаг 2 с confirmed=true и to_role → запись."
msgstr ""
"为订单分配运营子角色（manager/logist/customs/payments）。第 1 步无 to_role/"
"confirmed → 表单；第 2 步带 confirmed=true 和 to_role → 写入。"

#: assistant/actions.py:814
msgid ""
"Добавить операторскую заметку к заказу (audit-log). Шаг 1 без text/confirmed "
"→ форма; шаг 2 → запись."
msgstr ""
"为订单添加运营备注（audit-log）。第 1 步无 text/confirmed → 表单；第 2 步 → "
"写入。"

#: assistant/actions.py:826
msgid ""
"Закрыть спор по заказу. resolution: refund|partial_refund|release|no_action. "
"Шаг 1 — форма; шаг 2 с confirmed=true → запись + side-effects на "
"payment_status."
msgstr ""
"关闭订单争议。resolution: refund|partial_refund|release|no_action。第 1 步——"
"表单；第 2 步带 confirmed=true → 写入 + 对 payment_status 的副作用。"

#: assistant/actions.py:841
msgid "Поиск ТН ВЭД (HS-code) по описанию детали или артикулу."
msgstr "按零件描述或货号搜索 ТН ВЭД（HS 编码）。"

#: assistant/actions.py:845
msgid ""
"Присвоить ТН ВЭД заказу. Шаг 1 без hs_code/confirmed — форма; шаг 2 с "
"confirmed=true → запись."
msgstr ""
"为订单指定 ТН ВЭД。第 1 步无 hs_code/confirmed——表单；第 2 步带 "
"confirmed=true → 写入。"

#: assistant/actions.py:850
msgid "ТН ВЭД, например 8413.50"
msgstr "HS 编码，例如 8413.50"

#: assistant/actions.py:851
msgid "Страна импорта ISO-2 (RU/BY/KZ/AM/KG)"
msgstr "进口国 ISO-2（RU/BY/KZ/AM/KG）"

#: assistant/actions.py:858
msgid ""
"Расчёт таможенной пошлины + НДС + сборов по заказу. Использует HS-code и "
"страну из заказа (или из параметров)."
msgstr ""
"按订单计算关税 + 增值税 + 各项费用。使用订单中的 HS 编码和国家/地区（或参数中"
"的）。"

#: assistant/actions.py:870
msgid "Проверка обязательных сертификатов для заказа (по ТН ВЭД)."
msgstr "检查订单所需的强制性证书（按 ТН ВЭД）。"

#: assistant/actions.py:878
msgid ""
"Зафиксировать загрузку сертификата на заказ. Шаг 1 — форма; шаг 2 с "
"confirmed=true."
msgstr "记录订单的证书上传。第 1 步——表单；第 2 步带 confirmed=true。"

#: assistant/actions.py:883
msgid "Тип сертификата (EAC, ТР ТС 010/2011...)"
msgstr "证书类型（EAC、ТР ТС 010/2011……）"

#: assistant/actions.py:891
msgid ""
"Санкционный скрининг по стране / контрагенту / категории. Возвращает уровень "
"риска (high/medium/low/none) и причины."
msgstr ""
"按国家/地区、交易方或类别进行制裁筛查。返回风险等级（high/medium/low/none）及"
"原因。"

#: assistant/actions.py:902
msgid ""
"Сводка по таможне: грузы на оформлении, готовы к выпуску, ждут документы, в "
"транзите."
msgstr "海关汇总：清关中、可放行、待文件、运输中的货物。"

#: assistant/actions.py:906
msgid ""
"Выпустить груз с таможни (status customs → transit_rf). Жёстко проверяет ТН "
"ВЭД и сертификаты. Шаг 1 — форма; шаг 2 с confirmed=true → запись + WS-"
"нотификация покупателю."
msgstr ""
"从海关放行货物（status customs → transit_rf）。严格检查 ТН ВЭД 和证书。第 1 "
"步——表单；第 2 步带 confirmed=true → 写入 + 向买家发送 WS 通知。"

#: assistant/actions.py:918
msgid ""
"Эскроу-сводка платформы: текущий holding, выплачено продавцам, возвращено "
"покупателям, открытые холды по заказам."
msgstr "平台托管汇总：当前 holding、已付给卖家、已退还买家、按订单的未结托管。"

#: assistant/actions.py:922
msgid ""
"Логистическая аналитика: KPI по статусам, средний срок доставки, разбивка по "
"перевозчикам."
msgstr "物流分析：按状态的 KPI、平均交货时间、按承运商细分。"

#: assistant/actions.py:926
msgid ""
"Платежная аналитика: разбивка по payment_status, средний чек, refund rate."
msgstr "支付分析：按 payment_status 细分、平均客单价、退款率。"

#: assistant/actions.py:931
msgid ""
"Точка входа в onboarding/KYB-процесс. Показывает текущий шаг или welcome-"
"экран."
msgstr "进入 onboarding/KYB 流程的入口。显示当前步骤或欢迎页。"

#: assistant/actions.py:935
msgid "Текущий статус KYB-верификации компании пользователя."
msgstr "用户公司当前的 KYB 验证状态。"

#: assistant/actions.py:939
msgid "Шаг 1/5 onboarding'а — наименование, ИНН, КПП, ОГРН."
msgstr "入驻第1/5步——名称、INN、KPP、OGRN。"

#: assistant/actions.py:949
msgid "Шаг 2/5 — юридический адрес."
msgstr "第 2/5 步 — 法定地址。"

#: assistant/actions.py:956
msgid "Шаг 3/5 — банковские реквизиты (банк, БИК, расч. счёт)."
msgstr "第3/5步——银行信息（开户行、BIK、结算账户）。"

#: assistant/actions.py:963
msgid "Шаг 4/5 — ФИО директора / уполномоченного лица."
msgstr "第4/5步——董事/授权人姓名。"

#: assistant/actions.py:970
msgid "Шаг 5/5 — отправить заполненную анкету оператору на проверку."
msgstr "第5/5步——将填好的表单提交运营方审核。"

#: assistant/actions.py:974
msgid "Очередь KYB-анкет на модерации (operator-only)."
msgstr "待审核的 KYB 表单队列（仅限运营方）。"

#: assistant/actions.py:978
msgid "Просмотр KYB-анкеты пользователя."
msgstr "查看用户的 KYB 申请。"

#: assistant/actions.py:986
msgid ""
"Одобрить KYB-анкету. Шаг 1 — preview; шаг 2 с confirmed=true — запись + WS-"
"нотификация заявителю."
msgstr ""
"批准 KYB 表单。第1步——预览；第2步设 confirmed=true——写入 + 向申请人发送 WS 通"
"知。"

#: assistant/actions.py:994
msgid ""
"Отклонить KYB с причиной. Шаг 1 — форма; шаг 2 с confirmed=true и reason — "
"запись + нотификация."
msgstr ""
"带原因拒绝 KYB。第1步——表单；第2步设 confirmed=true 并填写 reason——写入 + 通"
"知。"

#: assistant/actions.py:1003
msgid ""
"Продавец создаёт котировку на RFQ. Шаг 1 без confirmed — форма (цены per-"
"line + срок + комментарий); шаг 2 с confirmed=true → запись Quote+QuoteItem."
msgstr ""
"卖方对 RFQ 创建报价。第1步未设 confirmed——表单（逐行价格 + 期限 + 备注）；第2"
"步设 confirmed=true → 写入 Quote+QuoteItem。"

#: assistant/actions.py:1019
msgid ""
"Покупатель видит все котировки по своему RFQ — sorted by total. Доступно "
"владельцу RFQ или оператору."
msgstr "买方查看其 RFQ 的所有报价——按总额排序。RFQ 所有者或运营方可访问。"

#: assistant/actions.py:1027
msgid "Детальная карточка котировки — позиции, статус, доступные actions."
msgstr "报价详情卡——条目、状态、可用操作。"

#: assistant/actions.py:1035
msgid ""
"Покупатель принимает котировку → создаётся Order. Шаг 1 — preview, шаг 2 с "
"confirmed=true."
msgstr "买方接受报价 → 创建 Order。第1步——预览，第2步设 confirmed=true。"

#: assistant/actions.py:1043
msgid ""
"Покупатель предлагает свою цену. Шаг 1 — форма со всеми позициями, шаг 2 с "
"confirmed=true → новая Quote (direction=buyer_to_seller, round_number+1)."
msgstr ""
"买方提出自己的价格。第1步——含所有条目的表单，第2步设 confirmed=true → 新建 "
"Quote（direction=buyer_to_seller，round_number+1）。"

#: assistant/actions.py:1051
msgid ""
"Продавец отвечает на контр-оффер — открывает форму submit_quote с "
"parent_quote_id."
msgstr "卖方回应反报价——打开带 parent_quote_id 的 submit_quote 表单。"

#: assistant/actions.py:1059
msgid ""
"Продавец фиксирует свою котировку как финальную (is_final=True) — переторжка "
"невозможна, покупатель только принимает или отклоняет."
msgstr ""
"卖方将其报价锁定为最终报价（is_final=True）——无法再议价，买方只能接受或拒绝。"

#: assistant/actions.py:1067
msgid "Покупатель отклоняет котировку. Уведомляет продавца."
msgstr "采购商拒绝报价。通知卖家。"

#: assistant/actions.py:1075
msgid ""
"Разослать RFQ кандидатам-поставщикам (верифицированные KYB приоритетно). "
"DraftCard preview → confirm."
msgstr "向候选供应商分发 RFQ（已验证 KYB 优先）。DraftCard 预览 → 确认。"

#: assistant/actions.py:1084
msgid "Текущие настройки durable-каналов (email, telegram, kinds)."
msgstr "持久化渠道的当前设置（email、telegram、kinds）。"

#: assistant/actions.py:1088
msgid ""
"Включить/выключить email-уведомления. Шаг 1 — форма; шаг 2 с confirmed=true."
msgstr "开启/关闭邮件通知。第1步——表单；第2步设 confirmed=true。"

#: assistant/actions.py:1095
msgid ""
"Какие типы событий доставлять в email/telegram (CSV из order/payment/rfq/sla/"
"claim/system/info)."
msgstr ""
"向 email/telegram 投递哪些事件类型（来自 order/payment/rfq/sla/claim/system/"
"info 的 CSV）。"

#: assistant/actions.py:1102
msgid ""
"Привязать Telegram chat_id для durable-доставки. Демо: ввести числовой "
"chat_id вручную."
msgstr "绑定 Telegram chat_id 以进行持久化投递。演示：手动输入数字 chat_id。"

#: assistant/actions.py:1110
msgid "Платформенная сводка для админа: GMV 7d, юзеры, заказы, KYB, SLA."
msgstr "面向管理员的平台概览：GMV 7d、用户、订单、KYB、SLA。"

#: assistant/actions.py:1114
msgid ""
"Лента важных событий: новые сделки/RFQ/загрузки прайса с кабинетом, IP и "
"позициями. Фильтр kind=all|order|rfq|pricelist."
msgstr ""
"重要事件流：新交易/RFQ/含账户、IP 和条目的价格表上传。筛选 kind=all|order|"
"rfq|pricelist。"

#: assistant/actions.py:1118
msgid "Платформенный GMV по периодам (24h/7d/30d/90d) + топ категорий."
msgstr "按周期统计的平台 GMV（24h/7d/30d/90d）+ 热门类目。"

#: assistant/actions.py:1122
msgid ""
"Список пользователей с фильтрами: all|active|banned|buyers|sellers|"
"kyb_pending."
msgstr "带筛选的用户列表：all|active|banned|buyers|sellers|kyb_pending。"

#: assistant/actions.py:1129
msgid ""
"Детальный профиль пользователя для админа: статусы, KYB, wallet, заказы."
msgstr "面向管理员的用户详细资料：状态、KYB、钱包、订单。"

#: assistant/actions.py:1137
msgid ""
"Заблокировать пользователя (User.is_active=False). Шаг 1 — форма с reason; "
"шаг 2 c confirmed=true → запись + WS-нотификация."
msgstr ""
"封禁用户（User.is_active=False）。第1步——带 reason 的表单；第2步设 "
"confirmed=true → 写入 + WS 通知。"

#: assistant/actions.py:1145
msgid "Разблокировать пользователя. DraftCard preview → confirm."
msgstr "解封用户。DraftCard 预览 → 确认。"

#: assistant/actions.py:1153
msgid ""
"Единая очередь модерации платформы: KYB pending, refunds, SLA breach, контр-"
"офферы."
msgstr "统一的平台审核队列：KYB pending、退款、SLA 违约、反报价。"

#: assistant/actions.py:1157
msgid ""
"Каталог-модерация: товары с price=$0, без seller'а, последние добавленные."
msgstr "目录审核：price=$0 的商品、无 seller 的商品、最近添加的商品。"

#: assistant/actions.py:1161
msgid "Read-only снэпшот платформенной конфигурации (engine, env vars)."
msgstr "平台配置的只读快照（engine、env vars）。"

#: assistant/actions.py:1166
msgid ""
"Сгенерировать TOTP secret и показать QR-код для сканирования в authenticator-"
"приложении."
msgstr "生成 TOTP secret 并显示二维码，以在 authenticator 应用中扫描。"

#: assistant/actions.py:1170
msgid "Подтвердить 6-значный OTP код и активировать 2FA."
msgstr "确认 6 位 OTP 验证码并激活 2FA。"

#: assistant/actions.py:1177
msgid "Выключить 2FA (требует ввода OTP кода для подтверждения)."
msgstr "关闭双重认证（需输入 OTP 验证码确认）。"

#: assistant/actions.py:1184
msgid "Сгенерировать API-токен для интеграций. Полный токен виден ОДИН раз."
msgstr "为集成生成 API token。完整 token 仅显示一次。"

#: assistant/actions.py:1195
msgid "Список API-токенов пользователя (активных и отозванных)."
msgstr "用户的 API token 列表（有效的与已吊销的）。"

#: assistant/actions.py:1199
msgid "Отозвать API-токен. DraftCard preview → confirm."
msgstr "吊销 API token。DraftCard 预览 → 确认。"

